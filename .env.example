# Copy to .env and replace every Placeholder* value before starting Compose.
# The repository-root .env must remain uncommitted.

# Pinned infrastructure image versions for the production-aligned local topology.
VAULT_VERSION=2.0.3
MSSQL_VERSION=2025-CU4-ubuntu-22.04
NEO4J_VERSION=5.26.28-community
MONGO_VERSION=8.0.26-noble
VALKEY_VERSION=8.0.9-alpine
POSTGRES_VERSION=17.10-alpine
TEMPORAL_VERSION=1.29.7
TEMPORAL_UI_VERSION=2.52.1

# Infrastructure credentials.
MSSQL_SA_PASSWORD=PlaceholderStrongPassword123!
GRAPH_PASSWORD=PlaceholderGraphPassword123!
MONGO_ROOT_USERNAME=mongoadmin
MONGO_ROOT_PASSWORD=PlaceholderMongoPassword123!
MONGO_REPLICA_SET_KEY=PlaceholderMongoReplicaSetKey1234567890
TEMPORAL_DB_PASSWORD=PlaceholderTemporalPassword123!
VALKEY_PASSWORD=PlaceholderValkeyPassword123!

# Runtime mode and public browser origin.
PLATFORM_ENVIRONMENT=development
PLATFORM_FRONTEND_CORS_ORIGIN=http://localhost:5173
# Used only by the optional containerized-app profile.
PLATFORM_CONTAINER_FRONTEND_CORS_ORIGIN=http://localhost:3200
# Host execution uses the version-controlled backend/config defaults. Compose overrides these paths.

# Bounded dependency and operation timeouts.
PLATFORM_PROBE_TIMEOUT_SECONDS=5
PLATFORM_DEPENDENCY_CONNECT_TIMEOUT_SECONDS=10
PLATFORM_OPERATION_TIMEOUT_SECONDS=15

# MongoDB. Compose overrides hosts to service DNS names.
PLATFORM_MONGO_DSN='mongodb://vault-resolved.invalid/return_platform'
PLATFORM_MONGO_DATABASE=return_platform
PLATFORM_SOURCE_MONGO_DSN='mongodb://vault-resolved.invalid/return_source'
PLATFORM_SOURCE_MONGO_DATABASE=return_source
PLATFORM_GRAPH_EVIDENCE_COLLECTION=graph_evidence_runs
PLATFORM_GRAPH_EVIDENCE_QUERY_TIMEOUT_SECONDS=5
PLATFORM_GRAPH_SYNC_BATCH_SIZE=250
PLATFORM_GRAPH_SYNC_MAX_RECORDS=10000
PLATFORM_AI_STUDIO_MAX_RECORDS=500
# AI Studio validation writes use a dedicated database, physically separate from
# platform/source databases. SQL apply remains disabled until separately configured.
PLATFORM_AI_STUDIO_MONGO_DATABASE=ai_studio_validation
PLATFORM_AI_STUDIO_SQLSERVER_HOST=
PLATFORM_AI_STUDIO_SQLSERVER_PORT=1433
PLATFORM_AI_STUDIO_SQLSERVER_USER=
PLATFORM_AI_STUDIO_SQLSERVER_PASSWORD=
PLATFORM_AI_STUDIO_SQLSERVER_DATABASE=
PLATFORM_SUPPORT_TICKET_MODE=INTERNAL
# Required only for INTERNAL_WITH_EXTERNAL_MIRROR or EXTERNAL_AUTHORITY.
PLATFORM_SUPPORT_TICKET_BASE_URL=
PLATFORM_SUPPORT_TICKET_API_KEY=
PLATFORM_SUPPORT_TICKET_TIMEOUT_SECONDS=15
PLATFORM_SUPPORT_TICKET_POLL_SECONDS=5
PLATFORM_SUPPORT_TICKET_MAX_POLLS=12
PLATFORM_FEEDBACK_LEARNING_ENABLED=true

# Neo4j.
#
# TWO PORTS, ONE NUMBER. `compose.yaml` publishes Bolt on
# `${NEO4J_BOLT_PORT:-7687}` -- overridable because WinNAT/Hyper-V can reserve
# 7687 and make the mapping unbindable -- while the URI below is what every host
# process dials. Move one without the other and nothing errors: the connection
# goes to a port with no listener, Order Discovery finds nothing, and an empty
# graph and an unreachable graph look identical from the copilot.
# `scripts/linux/validate_env.py` refuses a mismatch, so set both or neither.
#
#   NEO4J_BOLT_PORT=17687
#   PLATFORM_NEO4J_URI=bolt://localhost:17687
#
# In-network consumers always use bolt://neo4j:7687 and are unaffected.
PLATFORM_NEO4J_URI=bolt://localhost:7687
PLATFORM_NEO4J_USER=neo4j
PLATFORM_NEO4J_PASSWORD=vault-resolved
PLATFORM_NEO4J_DATABASE=neo4j

# Valkey Streams and resumable SSE.
PLATFORM_VALKEY_HOST=localhost
PLATFORM_VALKEY_PORT=6379
PLATFORM_VALKEY_PASSWORD=vault-resolved
PLATFORM_EVENT_STREAM_RETENTION=10000
PLATFORM_SSE_HEARTBEAT_SECONDS=15
PLATFORM_SSE_REPLAY_LIMIT=1000

# Temporal.
PLATFORM_TEMPORAL_TARGET=localhost:7233
PLATFORM_RETURN_WORKFLOW_TASK_QUEUE=return-platform-return-v1
PLATFORM_ORCHESTRATION_POLL_SECONDS=1
PLATFORM_WORKER_READINESS_TTL_SECONDS=30

# SQL Server authoritative return/RMA/tracking state.
PLATFORM_SQLSERVER_HOST=localhost
PLATFORM_SQLSERVER_PORT=14330
PLATFORM_SQLSERVER_USER=sa
PLATFORM_SQLSERVER_PASSWORD=vault-resolved
PLATFORM_SQLSERVER_DATABASE=return_platform

# Vault is the exclusive runtime credential source. The direct values above are
# used only to initialize local infrastructure and seed Vault through the Linux
# bootstrap script. API and worker processes resolve the references below.
#
# TURNING VAULT OFF MEANS CLEARING EVERY `*_SECRET_REFERENCE` BELOW, not just
# flipping this flag. A `vault://` reference with no resolver behind it is worse
# than no reference: it looks configured and resolves to nothing, and the
# process hangs in `Waiting for application startup` forever rather than
# failing. `compose.novault.yaml` does exactly this for the containerized
# profile; a host process run with PLATFORM_VAULT_ENABLED=false has to do it
# itself, and must also replace the seven `vault-resolved` sentinel values above
# with real credentials -- otherwise those literal strings become the passwords.
PLATFORM_VAULT_ENABLED=true
PLATFORM_VAULT_ADDRESS=http://127.0.0.1:8200
PLATFORM_VAULT_TOKEN_FILE=.vault-local/return-platform.token
PLATFORM_VAULT_VERIFY_TLS=false
PLATFORM_MONGO_DSN_SECRET_REFERENCE='vault://secret/production/data-sources/mongodb#dsn'
PLATFORM_SOURCE_MONGO_DSN_SECRET_REFERENCE='vault://secret/production/data-sources/mongodb#source_dsn'
PLATFORM_NEO4J_PASSWORD_SECRET_REFERENCE='vault://secret/production/data-sources/neo4j#password'
PLATFORM_VALKEY_PASSWORD_SECRET_REFERENCE='vault://secret/production/data-sources/valkey#password'
PLATFORM_SQLSERVER_PASSWORD_SECRET_REFERENCE='vault://secret/production/data-sources/sqlserver#password'
PLATFORM_VALIDATION_FINGERPRINT_KEY_SECRET_REFERENCE='vault://secret/production/platform/validation#fingerprint_key'
PLATFORM_VALIDATION_FINGERPRINT_KEY=PlaceholderValidationFingerprintKeyChangeMe
PLATFORM_CONTACT_LOOKUP_HMAC_KEY_SECRET_REFERENCE='vault://secret/production/platform/contact-lookup#hmac_key'
PLATFORM_CONTACT_LOOKUP_HMAC_KEY=PlaceholderContactLookupHmacKeyChangeMe

# AI gateway policy.
# MANUAL is also a valid provider name for local dev/test: it hands each request
# to a human instead of a model. Put it LAST in the order so it is the keyless
# fallback rather than the default -- a deployment with a credential never
# reaches it, and a deployment with none *holds* the request for an operator
# instead of failing the turn with attempts=0.
#
# Where the human answers is PLATFORM_AI_MANUAL_HANDOFF: UI (the durable
# interception store, answered in the AI Control Center), FILE (.manual_llm/
# beside the process CWD, answered by scripts/manual_llm_responder.py), or AUTO
# (the default: UI when the process has a store, FILE otherwise).
#
# Never allowed in production -- Settings refuses MANUAL in this list outside
# development and test, and both manual providers refuse to answer there.
PLATFORM_AI_PROVIDER_ORDER=NONE
PLATFORM_AI_TIMEOUT_SECONDS=12
PLATFORM_AI_GLOBAL_TIMEOUT_SECONDS=30
PLATFORM_AI_MAX_ATTEMPTS_PER_PROVIDER=2
PLATFORM_AI_MAX_CONCURRENCY=16
PLATFORM_AI_REQUESTS_PER_MINUTE=120
PLATFORM_AI_MAX_PAYLOAD_BYTES=16384
PLATFORM_AI_INTERCEPTION_DEFAULT=false
PLATFORM_AI_PROMPT_VERSION=return-eligibility-v1
PLATFORM_AI_ALLOWED_ENDPOINT_HOSTS='["generativelanguage.googleapis.com","integrate.api.nvidia.com","api.openai.com","api.anthropic.com"]'
PLATFORM_DATA_SOURCE_ALLOWED_HOSTS='["mongodb","source-mongodb","sqlserver","neo4j","localhost","127.0.0.1","::1"]'
PLATFORM_DATA_SOURCE_CREDENTIAL_REVEAL_ENABLED=false

# Provider credentials and model pools. Use JSON lists. Empty lists are allowed.
# The legacy single-key/model variables remain supported temporarily, but list settings win.
# Catalog listing and a minimal generation can be verified with:
# poetry run --directory backend python scripts/probe_configured_ai_models.py
# No model is trusted by default. Add a key through the validation control plane,
# discover accessible models, validate the selected model/task combinations, then
# publish the resulting Vault references and model lists.
PLATFORM_GOOGLE_API_KEYS='[]'
PLATFORM_GOOGLE_API_KEY_REFERENCES='[]'
# Model lists are ORDERED BY MEASUREMENT, not preference. 74 real calls over 12
# models on 2026-08-16, five real ORDER_AGENT_REASONING_V1 scenarios scored
# against the real AgentAction and the real guards. Full numbers in README.md.
#
#   models/gemini-3.5-flash-lite            6/10   median 3.2s   fastest that works
#   models/gemini-3.6-flash                 5/10   median  17s
#   nvidia/llama-3.3-nemotron-super-49b-v1.5  7-8/10 median  56s   most correct, slow
#
# Standing policy: the newest model takes the first slot. Verify it is actually
# in the catalogue before listing it -- `GET {base}/models?key=…` for Google,
# `GET {base}/models` for NVIDIA -- and measure it, because newer has repeatedly
# not meant better here.
#
# The task needs a ~19,400-token prompt, so a model with a small context window
# cannot serve it at all. Declare any such model in `backend/config/ai_gateway.yaml`
# under `modelContexts` and its route is dropped before a request is built,
# rather than returning HTTP 400 on every turn.
# The full stable flash line, newest first. Enumerate it from the live catalogue
# rather than copying this list forward -- new models appear and old ones are
# retired: GET ${PLATFORM_GOOGLE_BASE_URL}/models?key=... filtered to models
# supporting `generateContent`. Previews are left out on purpose; one can be
# withdrawn without notice, which is a poor property for a fallback rung.
#
# Availability is a listing criterion, not only quality. `gemini-3.7-flash` is
# absent although it is the newest: measured 2026-08-16 it returned HTTP 503 on 15
# of 21 non-429 attempts. A 503 raises PROVIDER_UNAVAILABLE, which opens the
# circuit for the whole *provider* rather than the model, so an unreliable rung
# anywhere in this list suspends every other Google model with it. Re-measure
# before adding it back.
PLATFORM_GOOGLE_LIGHTWEIGHT_MODELS='["models/gemini-3.5-flash-lite", "models/gemini-3.1-flash-lite", "models/gemini-2.5-flash-lite"]'
PLATFORM_GOOGLE_STANDARD_MODELS='["models/gemini-3.6-flash", "models/gemini-3.5-flash", "models/gemini-2.5-flash"]'
PLATFORM_GOOGLE_BASE_URL=https://generativelanguage.googleapis.com/v1beta

PLATFORM_NVIDIA_API_KEYS='[]'
PLATFORM_NVIDIA_API_KEY_REFERENCES='[]'
# `nemotron-mini-4b-instruct` was here and is removed: a 4,096-token window
# against a 19,386-token prompt, so it returned HTTP 400 on every call.
# `nemotron-3-super-120b-a12b` is likewise unfit -- it leaks chain-of-thought
# into `content` and exhausts its output cap before the JSON is complete.
#
# Three candidates were probed against the live account on 2026-08-16 to replace
# the dropped rung, and none earned a place: `llama-3.1-nemotron-70b-instruct`
# returned HTTP 404 ("not found for account" -- being in the catalogue is not
# being enabled on it), `meta/llama-3.3-70b-instruct` did not answer inside 90
# seconds, and `nemotron-3-nano-30b-a3b` answered in 0.8s but put reasoning
# prose ahead of its JSON, which this task's contract forbids. Four rungs, all
# four verified present in the catalogue.
PLATFORM_NVIDIA_LIGHTWEIGHT_MODELS='["meta/llama-3.1-8b-instruct", "meta/llama-3.2-3b-instruct"]'
PLATFORM_NVIDIA_STANDARD_MODELS='["nvidia/llama-3.3-nemotron-super-49b-v1.5", "nvidia/llama-3.3-nemotron-super-49b-v1"]'
PLATFORM_NVIDIA_BASE_URL=https://integrate.api.nvidia.com/v1

PLATFORM_OPENAI_API_KEYS='[]'
PLATFORM_OPENAI_API_KEY_REFERENCES='[]'
PLATFORM_OPENAI_LIGHTWEIGHT_MODELS='[]'
PLATFORM_OPENAI_STANDARD_MODELS='[]'
PLATFORM_OPENAI_BASE_URL=https://api.openai.com/v1

PLATFORM_ANTHROPIC_API_KEYS='[]'
PLATFORM_ANTHROPIC_API_KEY_REFERENCES='[]'
PLATFORM_ANTHROPIC_LIGHTWEIGHT_MODELS='[]'
PLATFORM_ANTHROPIC_STANDARD_MODELS='[]'
PLATFORM_ANTHROPIC_BASE_URL=https://api.anthropic.com/v1
PLATFORM_ANTHROPIC_VERSION=2023-06-01

PLATFORM_OLLAMA_BASE_URL=http://localhost:11434/v1
PLATFORM_OLLAMA_LIGHTWEIGHT_MODELS='[]'
PLATFORM_OLLAMA_STANDARD_MODELS='[]'

# Version-controlled task tiers, rate limits, retry policy, circuit breakers, and domain rules.
# PLATFORM_AI_GATEWAY_CONFIGURATION_PATH defaults to backend/config/ai_gateway.yaml.

# Seed and retention.
PLATFORM_SEED_VERSION=e2e-v2
# Optional per-collection cap for lower-resource validation hosts.
# Leave empty to use the counts in backend/config/seed/e2e_seed_manifest.json.
PLATFORM_SEED_RECORD_LIMIT=
PLATFORM_AUDIT_RETENTION_DAYS=90

# Vite development proxy only. Production Nginx proxies directly to backend.
FRONTEND_BACKEND_TARGET=http://localhost:8000

# Optional approved external integration adapters. When blank, outbox commands remain
# visible as BLOCKED_EXTERNAL_DEPENDENCY rather than being fabricated by AI.
PLATFORM_OMC_COMMAND_BASE_URL=
PLATFORM_OMC_COMMAND_API_KEY=
PLATFORM_CARRIER_BOOKING_BASE_URL=
PLATFORM_CARRIER_BOOKING_API_KEY=
PLATFORM_CUSTOMER_NOTIFICATION_BASE_URL=
PLATFORM_CUSTOMER_NOTIFICATION_API_KEY=


# Stage 4M external dependency adapter modes.
# SIMULATED is permitted only in development/test. Production startup rejects it.
PLATFORM_OMC_DEPENDENCY_MODE=SIMULATED
PLATFORM_PARCEL_DEPENDENCY_MODE=SIMULATED
PLATFORM_FREIGHT_DEPENDENCY_MODE=SIMULATED
PLATFORM_LSI_DEPENDENCY_MODE=SIMULATED
# Version-controlled behavior, lightweight models, fallback templates, and metric pricing.
# PLATFORM_DEPENDENCY_SIMULATION_CONFIGURATION_PATH uses backend/config/dependency_simulation.yaml by default

# Startup validation is opt-in. Normal startup never probes live AI providers.
PLATFORM_VALIDATE_AI_ON_STARTUP=false
# Dynamic knowledge Order Discovery
PLATFORM_DYNAMIC_ORDER_AGENT_ENABLED=true
PLATFORM_DYNAMIC_KNOWLEDGE_SCHEMA_PATH=backend/config/dynamic_knowledge/active-schema.return-order.yaml

# The packaged configuration tree the manifest-driven loader walks -- the agent
# module documents the Configuration screen edits live under it. Relative values
# resolve against the repository root, which is what a source checkout wants;
# containers set /app/config, because the installed package's own location is
# not the config tree's parent there. compose.yaml already sets it.
PLATFORM_CONFIGURATION_DIRECTORY=backend/config

# Live AI validation cadence; normal startup never validates AI.
PLATFORM_AI_VALIDATION_INTERVAL_HOURS=24
PLATFORM_AI_VALIDATION_RECEIPT_TTL_HOURS=24
PLATFORM_AI_TRANSIENT_COOLDOWN_INITIAL_SECONDS=300
PLATFORM_AI_TRANSIENT_COOLDOWN_MAX_SECONDS=3600
PLATFORM_AI_MAX_RECOVERY_PROBES_PER_REQUEST=1
