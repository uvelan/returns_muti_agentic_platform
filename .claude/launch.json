{
  "version": "0.0.1",
  "configurations": [
    {
      "name": "backend",
      "runtimeExecutable": "backend/.venv/Scripts/python.exe",
      "runtimeArgs": [
        "-m",
        "uvicorn",
        "return_platform.asgi:app",
        "--host",
        "127.0.0.1",
        "--port",
        "8000"
      ],
      "port": 8000
    },
    {
      "name": "order-discovery-worker",
      "runtimeExecutable": "backend/.venv/Scripts/python.exe",
      "runtimeArgs": [
        "backend/scripts/run_order_discovery_worker.py"
      ],
      "autoPort": true
    },
    {
      "name": "return-workflow-worker",
      "runtimeExecutable": "backend/.venv/Scripts/python.exe",
      "runtimeArgs": [
        "backend/scripts/run_return_workflow_worker.py"
      ],
      "autoPort": true
    },
    {
      "name": "return-orchestrator",
      "runtimeExecutable": "backend/.venv/Scripts/python.exe",
      "runtimeArgs": [
        "backend/scripts/run_return_orchestrator.py"
      ],
      "autoPort": true
    },
    {
      "name": "outbox-publisher",
      "runtimeExecutable": "backend/.venv/Scripts/python.exe",
      "runtimeArgs": [
        "backend/scripts/run_outbox_publisher.py"
      ],
      "autoPort": true
    },
    {
      "name": "integration-outbox-worker",
      "runtimeExecutable": "backend/.venv/Scripts/python.exe",
      "runtimeArgs": [
        "-m",
        "return_platform.workers.integration_outbox"
      ],
      "autoPort": true
    },
    {
      "name": "order-discovery-worker-manual",
      "runtimeExecutable": "backend/.venv/Scripts/python.exe",
      "runtimeArgs": [
        "qa/tc-e2e-02/run_worker_manual.py",
        "backend/scripts/run_order_discovery_worker.py"
      ],
      "autoPort": true
    },
    {
      "name": "return-workflow-worker-manual",
      "runtimeExecutable": "backend/.venv/Scripts/python.exe",
      "runtimeArgs": [
        "qa/tc-e2e-02/run_worker_manual.py",
        "backend/scripts/run_return_workflow_worker.py"
      ],
      "autoPort": true
    },
    {
      "name": "frontend",
      "runtimeExecutable": "npm",
      "runtimeArgs": [
        "--prefix",
        "frontend",
        "run",
        "dev",
        "--",
        "--port",
        "5273"
      ],
      "port": 5273
    },
    {
      "name": "frontend-mock",
      "runtimeExecutable": "npm",
      "runtimeArgs": [
        "--prefix",
        "frontend",
        "run",
        "dev:mock",
        "--",
        "--port",
        "5174"
      ],
      "port": 5174
    }
  ]
}
