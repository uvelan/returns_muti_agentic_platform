{
  "compilerOptions": {
    "tsBuildInfoFile": "../.tmp/frontend-tsconfig.app.tsbuildinfo",
    "target": "es2023",
    "lib": ["ES2023", "DOM"],
    "module": "esnext",
    "types": ["vite/client"],
    "allowArbitraryExtensions": true,
    "skipLibCheck": true,
    "strict": true,

    /* Bundler mode */
    "moduleResolution": "bundler",
    "allowImportingTsExtensions": true,
    "verbatimModuleSyntax": true,
    "moduleDetection": "force",
    "noEmit": true,
    "jsx": "react-jsx",

    /* Linting */
    "noUnusedLocals": true,
    "noUnusedParameters": true,
    "noFallthroughCasesInSwitch": true
  },
  // `tests` is Playwright, which runs in node and reads `process.env`. It was
  // included here, where `types` is `vite/client` only, so the browser config
  // typechecked node code and `npm run build` failed on `process`. Adding node
  // types here instead would let browser sources reach node globals, which is
  // the wrong half of the problem to fix.
  "include": ["src"]
}
